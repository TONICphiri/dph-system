{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'Vite assets are committed; vercel-php builds api/index.php.'",
  "regions": ["fra1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,tests/**,docs/**,deploy/**,storage/**,.env*,.git/**,.vercel/**,database/database.sqlite,phpunit.xml,composer.json,composer.lock,artisan,package.json,package-lock.json,vite.config.js,tailwind.config.js,postcss.config.js}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 5 * * *" },
    { "path": "/api/cron/maintenance", "schedule": "0 0 * * *" }
  ]
}
