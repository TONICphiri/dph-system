{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.2-custom",
  "agent": "build",
  "share": true,
  "variant": "high",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.2-custom": {
          "modelID": "gpt-5.2",
          "name": "GPT-5.2 Custom"
        }
      }
    },
    "opencode-zen": {
      "models": {
        "minimax-2.5": {
          "modelID": "minimax-2.5",
          "name": "OpenCode Zen Free Model"
        }
      }
    }
  },
  "mcp": {
    "documentation-server": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    }
  }
}


