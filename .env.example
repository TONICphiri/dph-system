APP_NAME="Digital Health Passport"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Blantyre

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# XAMPP defaults. Create the database in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=health_passport
DB_USERNAME=root
DB_PASSWORD=

# Optional read replica. Leave disabled unless the replica exists.
DB_READ_REPLICA_ENABLED=false
DB_READ_HOST=127.0.0.1
DB_READ_PORT=3306
DB_READ_DATABASE=health_passport
DB_READ_USERNAME=root
DB_READ_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Local HTTP only. Set to true when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Redis is optional. The cache, queue and session drivers above use the
# database. If you switch them to redis, install the phpredis extension (or
# add predis/predis to Composer) on every web and queue server.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@healthpassport.mw"
MAIL_FROM_NAME="${APP_NAME}"

# Set these only when MAIL_MAILER=mailgun.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set this for an S3 compatible provider such as Cloudflare R2.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave unset to serve assets from the application itself. Set only when a
# real CDN in front of the site serves /build.
# ASSET_URL=https://cdn.example.org

VITE_APP_NAME="${APP_NAME}"

# Digital Health Passport
# Load demonstration facilities, staff and patients. Set to false on the live server.
SEED_DEMO_DATA=true
# Protects the optional /api/cron endpoints on hosts without a system
# scheduler. Generate a long random value (for example
# `php -r "echo bin2hex(random_bytes(32));"`) and send it as
# `Authorization: Bearer <value>`. Leave empty when using server cron.
CRON_SECRET=
# Where database backups are written. Use s3 (or an S3 compatible bucket such
# as Cloudflare R2) when the server's local disk is not durable.
BACKUP_DISK=local
# Time the daily backup runs, in the application timezone.
BACKUP_TIME=02:00
# First System Administrator account. Set a strong password, or leave it
# empty and run `php artisan admin:create` to type it once, hidden.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@healthpassport.mw
ADMIN_PASSWORD=
# Seconds between checks for new notifications in the browser.
NOTIFICATION_POLL_SECONDS=60
# Rows shown per page in lists.
LIST_PAGE_SIZE=15

SMS_DRIVER=log
SMS_TIMEOUT_SECONDS=10

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

AFRICASTALKING_USERNAME=
AFRICASTALKING_KEY=
AFRICASTALKING_FROM=
AFRICASTALKING_ENV=production

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# These defaults are safe for local development. The production values are in
# deploy/env.production.example.
SECURE_HEADERS=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
# Keep the quotes: the value contains a space.
X_XSS_PROTECTION="1; mode=block"
REFERRER_POLICY=strict-origin-when-cross-origin
# Alpine.js needs 'unsafe-eval'. Remove it only if Alpine's CSP build is used.
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=120
RATE_LIMIT_REGISTER=3

# The application is same-origin, so CORS is off. Enable only for a real
# cross-origin API and then list the exact origins.
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-CSRF-TOKEN
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# Comma-separated addresses of the reverse proxy in front of PHP. Never use a
# public range here; it would let clients spoof X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1
# Redirect generated URLs to HTTPS and send HSTS. Enable in production.
FORCE_HTTPS=false

# Compress text responses in PHP. Nginx may already do this.
RESPONSE_COMPRESSION=false
SLOW_REQUEST_THRESHOLD_MS=1000

# Audit log rows older than this are removed by the scheduled audit:prune.
AUDIT_LOG_RETENTION_DAYS=365
