APP_NAME="Digital Health Passport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Blantyre

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP defaults. Create the database in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=health_passport
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap is the development SMTP target. Fill credentials from a
# Mailtrap inbox; never commit real secrets. QUEUE_CONNECTION=database
# (set below) so every notification is queued (php artisan queue:work).
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="Digital Health Passport"

# Encrypted database backups (spatie/laravel-backup, MySQL only).
# BACKUP_ARCHIVE_PASSWORD is REQUIRED to run backups outside testing.
# Never commit real values. MYSQLDUMP_PATH is only needed when mysqldump
# is not on the server PATH.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_EMAIL_RECIPIENT=
BACKUP_EMAIL_MAX_MB=20
MYSQLDUMP_PATH=

# Backup mail goes through its own mailer so normal notifications can stay
# on Mailtrap while backup mail uses a real SMTP provider.
MAIL_BACKUP_MAILER=smtp
MAIL_BACKUP_HOST=
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_ENCRYPTION=tls
MAIL_BACKUP_FROM_ADDRESS=
MAIL_BACKUP_FROM_NAME="Digital Health Passport Backup"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Digital Health Passport
# Load demonstration facilities, staff and patients. Set to false on the live server.
SEED_DEMO_DATA=true
# First System Administrator account. Change the password before going live.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@healthpassport.mw
ADMIN_PASSWORD=Password@2026
# Seconds between checks for new notifications in the browser.
NOTIFICATION_POLL_SECONDS=60
# Rows shown per page in lists.
LIST_PAGE_SIZE=15
