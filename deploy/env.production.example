# ---------------------------------------------------------------------------
# Production environment template
# ---------------------------------------------------------------------------
# Copy these values into the server's .env. Never commit the real .env.
# Replace every CHANGE_ME before the first request.
# ---------------------------------------------------------------------------

APP_NAME="Digital Health Passport"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME
APP_TIMEZONE=Africa/Blantyre

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

DB_READ_REPLICA_ENABLED=false
DB_READ_HOST=127.0.0.1
DB_READ_PORT=3306
DB_READ_DATABASE=CHANGE_ME
DB_READ_USERNAME=CHANGE_ME
DB_READ_PASSWORD=

# Database drivers are the safe default. To use Redis, install the phpredis
# extension on every web and queue server, then switch these three to redis.
SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# A real mailer is required for password resets and reminders. "log" is only
# for development.
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=CHANGE_ME
MAILGUN_SECRET=CHANGE_ME
MAILGUN_ENDPOINT=api.eu.mailgun.net

# A durable backup disk is strongly recommended. For S3/R2 set BACKUP_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_DISK=local
BACKUP_TIME=02:00

# Leave unset unless a real CDN serves /build. A wrong value breaks every
# stylesheet and script.
# ASSET_URL=https://cdn.CHANGE_ME

VITE_APP_NAME="${APP_NAME}"

SEED_DEMO_DATA=false
CRON_SECRET=
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@CHANGE_ME
ADMIN_PASSWORD=

NOTIFICATION_POLL_SECONDS=60
LIST_PAGE_SIZE=15

SMS_DRIVER=log
SMS_TIMEOUT_SECONDS=10
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
AFRICASTALKING_USERNAME=
AFRICASTALKING_KEY=
AFRICASTALKING_FROM=
AFRICASTALKING_ENV=production

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECURE_HEADERS=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
REFERRER_POLICY=strict-origin-when-cross-origin
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=120
RATE_LIMIT_REGISTER=3

CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-CSRF-TOKEN
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# The address of the reverse proxy, not a public subnet.
TRUSTED_PROXIES=127.0.0.1
FORCE_HTTPS=true

RESPONSE_COMPRESSION=true
SLOW_REQUEST_THRESHOLD_MS=1000

AUDIT_LOG_RETENTION_DAYS=365
